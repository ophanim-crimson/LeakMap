# Database Config
# For local development with docker/local postgres:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leakmap

# For production (Render/Neon):
# DATABASE_URL=postgresql://user:password@neon-host:5432/leakmap?sslmode=require

# Backend Settings
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limit settings
RATE_LIMIT_LIMIT=100
RATE_LIMIT_PERIOD_SECONDS=3600
